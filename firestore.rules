rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsCase(caseId) {
      return signedIn()
        && get(/databases/$(database)/documents/cases/$(caseId)).data.ownerId == request.auth.uid;
    }

    match /cases/{caseId} {
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == "draft";
      allow read: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && resource.data.status == "draft"
        && request.resource.data.status == "draft"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "equipmentTag",
          "projectId",
          "requiredOnSiteDate",
          "specifiedProduct",
          "supplierDelayEmail",
          "updatedAt"
        ]);
      allow delete: if false;

      match /{subcollection}/{documentId} {
        allow read: if ownsCase(caseId);
        allow write: if false;
      }
    }

    match /projects/{projectId} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}
