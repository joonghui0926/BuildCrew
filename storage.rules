rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /cases/{ownerId}/{caseId}/{allPaths=**} {
      allow read: if request.auth != null
        && request.auth.uid == ownerId;
      allow write: if request.auth != null
        && request.auth.uid == ownerId
        && request.resource.size < 50 * 1024 * 1024;
    }
  }
}
